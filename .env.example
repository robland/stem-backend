# Copier vers .env (racine du dépôt) et compléter. Ne jamais committer .env.
# Dans Docker Compose, DATABASE_URL / CELERY_BROKER_URL sont fournis par docker-compose.yml.

SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=

FRONTEND_URL=http://localhost:5173
# Origines autorisées (séparées par des virgules). Par défaut : FRONTEND_URL.
CORS_ALLOWED_ORIGINS=

# Hors Docker uniquement (sinon SQLite / Redis local par défaut)
DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0

# "None" si le front et l'API sont sur des domaines différents (HTTPS obligatoire)
REFRESH_COOKIE_SAMESITE=Lax

# LLM (modèle par tâche, voir llm/)
LLM_MODEL_EXTRACTION=gpt-4.1-mini
LLM_MODEL_GENERATION=gpt-4.1-mini
